{
  "name": "forms",
  "title": "Custom Forms",
  "version": "1.0.3",
  "description": "Visual drag-and-drop form builder, embed anywhere via shortcode or sidebar widget, with automated spam honeypot and submissions management.",
  "permissions": ["content.read", "content.write", "settings.read", "settings.write"],

  "hooks": ["shortcode", "formRender", "formSubmit"],
  "subscribes": ["FormSubmitted"],

  "tables": [
    {
      "name": "forms",
      "label": "Custom Forms",
      "fields": [
        { "key": "name", "type": "text", "label": "Form Name" },
        { "key": "description", "type": "longtext", "label": "Description" },
        { "key": "fields_schema", "type": "longtext", "label": "Fields Schema" },
        { "key": "settings_schema", "type": "longtext", "label": "Settings Schema" }
      ],
      "translatable": ["name", "description", "fields_schema", "settings_schema"]
    },
    {
      "name": "submissions",
      "label": "Form Submissions",
      "fields": [
        { "key": "form_slug", "type": "text", "label": "Form Slug" },
        { "key": "payload", "type": "longtext", "label": "Payload JSON" },
        { "key": "ip_hash", "type": "text", "label": "IP Hash" },
        { "key": "user_agent", "type": "text", "label": "User Agent" }
      ],
      "translatable": ["form_slug", "payload", "ip_hash", "user_agent"]
    }
  ],

  "adminMenus": [
    {
      "id": "forms-manager",
      "label": "Custom Forms",
      "icon": "file-text",
      "screen": "forms-manager",
      "capability": "content.read"
    }
  ],

